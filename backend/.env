# KayaPure Commerce OS - Environment Configuration
DATABASE_URL=postgresql://kayapure:kayapure123@localhost:5432/kayapure_db
DATABASE_URL_ASYNC=postgresql+asyncpg://kayapure:kayapure123@localhost:5432/kayapure_db

# LLM Configuration
OPENAI_API_KEY=${OPENAI_API_KEY}
STRATEGY_MODEL=gpt-4.1-mini
PARSING_MODEL=gpt-4.1-nano

# Security
SECRET_KEY=kayapure-secret-key-change-in-production
ENCRYPTION_KEY=kayapure-encryption-key-32bytes!

# Firecracker (Mock Mode)
FIRECRACKER_MOCK=true
VM_BOOT_TIME_MS=125
VM_SNAPSHOT_PATH=/tmp/firecracker/snapshots

# API Keys (legacy direct integrations, managed by SecretManager)
SHOPIFY_API_KEY=mock_shopify_key
META_ADS_API_KEY=mock_meta_ads_key
AMAZON_SP_API_KEY=mock_amazon_sp_key
FLEXPORT_API_KEY=mock_flexport_key

# ============================================
# MCP (Model Context Protocol) Configuration
# ============================================
# Set MCP_ENABLED=true to switch from mock data to live Meta Ads data.
# Requires a valid Pipeboard token and Meta Ads account ID.
MCP_ENABLED=true

# Meta Ads MCP Server (Pipeboard hosted)
# URL of the Pipeboard-hosted Meta Ads MCP server
MCP_META_ADS_URL=https://mcp.pipeboard.co/meta-ads-mcp

# Pipeboard API token — obtain from https://pipeboard.co/api-tokens
# after connecting your Facebook Ads account
MCP_META_ADS_TOKEN=pk_df64e5d40c814bf1aeb1a3f25283aac0

# Your Meta Ads account ID (e.g., act_123456789)
# Find it in Meta Ads Manager → Account Settings
META_ADS_ACCOUNT_ID=act_520709504005746
