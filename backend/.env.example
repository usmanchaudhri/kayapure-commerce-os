# KayaPure Commerce OS - Environment Configuration
# Copy this file to .env and fill in your values.

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://kayapure:kayapure123@localhost:5432/kayapure_db
DATABASE_URL_ASYNC=postgresql+asyncpg://kayapure:kayapure123@localhost:5432/kayapure_db

# ============================================
# LLM Configuration
# ============================================
OPENAI_API_KEY=your-openai-api-key-here
STRATEGY_MODEL=gpt-4.1-mini
PARSING_MODEL=gpt-4.1-nano
LLM_BASE_MODEL=gemini-3.1-pro-preview
LLM_BASE_MODEL_API_KEY=
# ============================================
# Security
# ============================================
SECRET_KEY=kayapure-secret-key-change-in-production
ENCRYPTION_KEY=kayapure-encryption-key-32bytes!

# ============================================
# Firecracker (Mock Mode)
# ============================================
FIRECRACKER_MOCK=true
VM_BOOT_TIME_MS=125
VM_SNAPSHOT_PATH=/tmp/firecracker/snapshots

# ============================================
# API Keys (legacy direct integrations)
# ============================================
SHOPIFY_API_KEY=mock_shopify_key
META_ADS_API_KEY=mock_meta_key
AMAZON_SP_API_KEY=mock_amazon_sp_key
FLEXPORT_API_KEY=mock_flexport_key

# ============================================
# Facebook Marketing API (Graph API v21.0)
# ============================================
# Set FACEBOOK_ADS_ENABLED=true to use live Meta Ads data instead of mock data.
FACEBOOK_ADS_ENABLED=false

# Long-Lived User Access Token (valid for 60 days)
# 1. Create a Facebook App at https://developers.facebook.com
# 2. Generate a short-lived token at https://developers.facebook.com/tools/explorer/
#    with permissions: ads_read, ads_management
# 3. Exchange for a long-lived token:
#    GET https://graph.facebook.com/v21.0/oauth/access_token
#      ?grant_type=fb_exchange_token
#      &client_id={app-id}
#      &client_secret={app-secret}
#      &fb_exchange_token={short-lived-token}
FACEBOOK_ACCESS_TOKEN=

# Your Meta Ads account ID (e.g., act_123456789)
# Find it in Meta Ads Manager → Account Settings
META_ADS_ACCOUNT_ID=act_your_account_id_here

# ============================================
# WhatsApp Cloud API
# ============================================
# Set WHATSAPP_ENABLED=true and configure token + phone number ID from Meta Business.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ============================================
# Apify (Amazon storefront data)
# ============================================
# Token from https://console.apify.com/settings/integrations
APIFY_TOKEN=
APIFY_WEBHOOK_SECRET=
# Public origin Apify can POST to (use an ngrok URL when developing locally)
APIFY_PUBLIC_BASE_URL=http://127.0.0.1:8000
APIFY_AMAZON_REVIEWS_ACTOR=junglee~amazon-reviews-scraper
APIFY_AMAZON_CATALOG_ACTOR=junglee~amazon-crawler

# ============================================
# LangSmith Tracing (Optional)
# ============================================
# Sign up at https://smith.langchain.com and create an API key.
# When enabled, every LangGraph agent cycle is traced with full
# node-by-node visibility, timing, and LLM call details.
LANGSMITH_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kayapure-commerce-os

# ============================================
# Feature Flags — Data Source Control
# ============================================
# Comma-separated list of enabled data sources.
# Only enabled sources will return live data; disabled ones return "not connected".
# Valid values: marketing, commerce, logistics, dwh, vm, diagnostic
# To enable all: ENABLED_SOURCES=marketing,commerce,logistics,dwh,vm,diagnostic
# To enable only marketing (Meta Ads): ENABLED_SOURCES=marketing
ENABLED_SOURCES=marketing

# ============================================
# Saleor MCP (https://mcp.saleor.app/)
# ============================================
# Local: uv run saleor-mcp  →  http://127.0.0.1:6000/mcp
# Hosted (Saleor Cloud): https://mcp.saleor.app/mcp
SALEOR_MCP_URL=http://127.0.0.1:6000/mcp
# Saleor GraphQL API URL (must end with /graphql/)
SALEOR_API_URL=https://api.example.com/graphql/
# App token with MANAGE_PRODUCTS + MANAGE_ORDERS
SALEOR_AUTH_TOKEN=

# ============================================
# PostEx COD Merchant API (https://www.postex.pk/)
# ============================================
# Merchant API token from PostEx (sent as header: token)
POSTEX_TOKEN=
# Optional override (default production API)
POSTEX_BASE_URL=https://api.postex.pk/services/integration/api/order/v1
# Optional email printed on CPR PDFs (Contact Details)
POSTEX_MERCHANT_EMAIL=info@kayapuressence.com
# Order sync / sales consolidation
POSTEX_SYNC_SINCE=2024-01-01
POSTEX_SYNC_LOOKBACK_DAYS=30
POSTEX_SYNC_CHUNK_DAYS=14
POSTEX_SYNC_ON_STARTUP=true

# ============================================
# Logging Configuration
# ============================================
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# LOG_DIR: directory for structured JSON log files
LOG_DIR=logs
